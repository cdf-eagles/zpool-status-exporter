name: release

on:
  pull_request:
    types: [closed]
    branches: ['main', 'develop']
    paths:
      - '**.go'
  workflow_dispatch:

env:
  REGISTRY: ghcr.io
  IMAGE_NAME: ${{ github.repository }}
  REPO_OWNER: "cdf-eagles"
  PROJECT_NAME: "zpool-status-exporter"

jobs:
  release:
    runs-on: ubuntu-latest
    strategy:
      matrix:
        os: ["freebsd", "linux"]
        arch: ["amd64", "arm64"]
    env:
      GOOS: ${{ matrix.os }}
      GOARCH: ${{ matrix.arch }}
      CGO_ENABLED: 0

    permissions:
      contents: read
      packages: write
      attestations: write
      id-token: write

    steps:
      - name: "Get Current Date/Time"
        id: datetime
        run: echo "::set-output name=datetime::$(date +'%Y-%m-%d %H:%M:%S')"

      - name: "Checkout"
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        id: checkout

      - name: "Log into the Container Registry"
        uses: docker/login-action@dbcb813823bdd20940b903addbd779551569679f
        id: registry_login
        with:
          registry: ${{ env.REGISTRY }}
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}

      - name: "Set Up Go"
        uses: actions/setup-go@b7ad1dad31e06c5925ef5d2fc7ad053ef454303e
        id: setup_go
        with:
          go-version: '1.26.x'

      - name: "Perform Semantic Version Tagging"
        uses: gandarez/semver-action@e4ad946cc2a1df2955cde270b9ee59bafaa08fa7
        id: semver-tag
        with:
          branching_model: "trunk-based"
          prefix: "v"
          main_branch_name: "main"
          develop_branch_name: "develop"
          patch_regex: "^fix/.+"
          minor_regex: "^feat/.+"
          major_regex: "^major/.+"
          build_regex: "^build/.+"
          exclude_regex: "^ignore/.+"

      - name: "Created Tag"
        run: echo "tag ${{ steps.semver-tag.outputs.semver_tag }}"

      - name: "Build Go Application"
        id: build_app
        run: |
          echo "Building for ${GOOS}-${GOARCH}"
          go build -o app/${PROJECT_NAME}-${GOOS}-${GOARCH} .

      - name: "Set Up Docker Buildx"
        uses: docker/setup-buildx-action@bb05f3f5519dd87d3ba754cc423b652a5edd6d2c

      - name: "Set Up QEMU"
        uses: docker/setup-qemu-action@96fe6ef7f33517b61c61be40b68a1882f3264fb8

      - name: "Extract Metadata"
        uses: docker/metadata-action@dc802804100637a589fabce1cb79ff13a1411302
        id: meta
        with:
          images: ${{ env.REGISTRY }}/${{ github.repository }}
          tags: |
            # Tag with branch name
            type=ref,event=branch
            # Tag with PR number
            type=ref,event=pr
            # Tag with semver from git tag
            type=semver,pattern={{version}}
            type=semver,pattern={{major}}.{{minor}}.{{patch}}
            # Tag with short SHA
            type=sha,prefix=

      - name: "Build (FreeBSD)"
        uses: vmactions/freebsd-vm@77ed28d336d03fe19a3f4f7266c1d2c4714dd79d
        id: build_freebsd_container
        env:
          SEMVER: "${{ steps.semver-tag.outputs.semver_tag }}"
          DATETIME: "${{ steps.datetime.outputs.datetime }}"
          REVISION: "${{ github.ref }}"
          IMAGE_SRC: "${{ github.repositoryUrl }}"
        with:
          usesh: true
          sync: nfs
          cpu: 2
          mem: 4096
          prepare: |

            run: |
                pwd
                ls -lah
                whoami
                env
                freebsd-version
                uname -a
                pkg install -y pkg podman curl
                pkg clean -y -a
                export PATH="${PATH}:/usr/local/bin:/usr/local/sbin"
                export PORT=62000
                if [ ! -d "./dist" ]; then mkdir -p ./dist; fi
                sha256 ./app/${PROJECT_NAME}-${GOOS}-${GOARCH}
                podman build -f ./docker/Dockerfile.freebsd \
                  --progress=plain \
                  --no-cache \
                  --build-arg TARGETOS=${GOOS} \
                  --build-arg TARGETARCH=${GOARCH} \
                  -t ${PROJECT_NAME}-${GOOS}-${GOARCH}:${SEMVER} \
                  -t ${PROJECT_NAME}-${GOOS}-${GOARCH}:latest \
                  --label description="Prometheus Exporter for ZPool Data & Status (${GOOS}/${GOARCH})" \
                  --label created=${DATETIME} \
                  --label name=${IMAGE_NAME} \
                  --label revision=${REVISION} \
                  --label version=${SEMVER} \
                  --label source=${IMAGE_SRC}
                podman run -d --name test -p ${PORT}:${PORT} ${PROJECT_NAME}-${GOOS}-${GOARCH}:latest
                podman logs test
                curl -f http://localhost:${PORT}
                container_status=$(podman inspect test --format '{{.State.Status}}')
                podman container stop test && podman container rm -f test
                if [ "$container_status" == "running" ]; then
                  podman save -o ./dist/${PROJECT_NAME}-${GOOS}-${GOARCH}.tar ${PROJECT_NAME}-${GOOS}-${GOARCH}:${SEMVER}
                  exit 0
                else
                  echo "ERROR: Container build failed! Not exporting."
                  exit 1
                fi

      - name: "Push FreeBSD Container Images"
        id: push_freebsd_container
        uses: redhat-actions/push-to-registry@94ade333c38ecc0e60e94785125d9a52ca423b37
        with:
          registry: ${{ env.REGISTRY }}/${{ github.repository_owner }}
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}
          image: ./dist/${{ env.PROJECT_NAME }}-${{ env.GOOS }}-${{ env.GOARCH }}.tar
          extra-args: |
            --disable-content-trust

      - name: "Echo FreeBSD Push Outputs"
        run: |
          echo "${{ toJSON(steps.push_freebsd_container.outputs) }}"

      - name: "Build and Push (Linux)"
        id: build_and_push_linux_container
        uses: docker/build-push-action@53b7df96c91f9c12dcc8a07bcb9ccacbed38856a
        with:
          context: ./
          file: docker/Dockerfile.linux
          platforms: linux/amd64,linux/arm64
          build-args: |
            "TARGETOS=${{ env.GOOS }}"
            "TARGETARCH=${{ env.GOARCH }}"
          labels: |
            "org.opencontainers.image.description": "Prometheus Exporter for ZPool Data & Status (${{ env.GOOS }}/${{ env.GOARCH }})"
            "org.opencontainers.image.created": "${{ steps.datetime.outputs.datetime }}"
            "org.opencontainers.image.name": "${{ github.repository }}"
            "org.opencontainers.image.revision": "${{ github.ref }}"
            "org.opencontainers.image.version": "${{ steps.semver-tag.outputs.semver_tag }}"
            "org.opencontainers.image.source": "${{ github.repositoryUrl }}"

      - name: "Echo Linux Push Outputs"
        run: |
          echo "${{ toJSON(steps.build_and_push_linux_container.outputs) }}"
