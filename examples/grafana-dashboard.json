          },
          "refId": "A",
          "editorMode": "code",
          "range": false,
          "expr": "zfs_smart_healthy{instance=~\"$instance\"} * on (instance, device) group_left (disk, model) zfs_smart_device_info{instance=~\"$instance\"}",
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "refId": "B",
          "editorMode": "code",
