          "expr": "zfs_smart_error_log_entries{instance=~\"$instance\"}",
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "refId": "C",
          "editorMode": "code",
          "range": false,
          "expr": "zfs_smart_power_on_seconds{instance=~\"$instance\"}",
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "refId": "D",
          "editorMode": "code",
          "range": false,
          "expr": "zfs_smart_device_standby{instance=~\"$instance\"}",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "power on"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "healthy"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "FAILING",
                        "color": "red",
                        "index": 0
                      },
                      "1": {
                        "text": "passed",
                        "color": "green",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {},
      "description": "healthy: SMART overall self-assessment. error log: entries in the device error log.",
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true
            },
            "renameByName": {
              "Value #A": "healthy",
              "Value #B": "error log",
              "Value #C": "power on",
              "Value #D": "standby"
            },
            "indexByName": {
              "disk": 1,
              "device": 2,
              "model": 3,
              "Value #A": 4,
              "Value #B": 5,
              "Value #C": 6,
              "Value #D": 7,
              "instance": 0
            }
          }
        }
      ]
    },
